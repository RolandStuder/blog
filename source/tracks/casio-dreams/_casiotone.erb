<%#
  Casiotone MT-140 – SVG rendering, proportions traced from a photo.
  viewBox: 1040 x 320 (body). Keys, buttons and sliders carry ids/classes so
  page.js can drive them (lighting keys, pressing buttons, decay effects).
%>
<%
  white_w = 980.0 / 29
  key_x0  = 43
  key_y   = 177
  white_h = 135
  black_w = 19
  black_h = 82
  names   = %w[C C# D Eb E F F# G Ab A Bb B]
  black_after = [0, 1, 3, 4, 5] # white-key index within octave that has a black key to its right
  rhythms = [
    ['ROCK 1', '8 BEAT 1', '16 BEAT 1', 'DISCO 1', 'POPS 1'],
    %w[ROCK\ 2 8\ BEAT\ 2 16\ BEAT\ 2 DISCO\ 2 POPS\ 2],
    %w[SLOW\ ROCK\ 1 SWING SAMBA BOSSA\ NOVA WALTZ],
    %w[SLOW\ ROCK\ 2 REGGAE TANGO BEGUINE MARCH],
  ]
  tones = [
    %w[PIANO HARPSI-CHORD VIBRAPHONE JAZZ\ ORGAN PIPE\ ORGAN],
    %w[ELEC\ PIANO FUNKY\ CLAV JAZZ\ GUITAR ORGAN ACCORDION],
    %w[BRASS\ ENS FLUTE CHORUS BELLS (MULTI\ SPLIT)\ PERCUSSION],
    %w[STRINGS SYNTH\ REED METALLIC\ SOUND SYNTH\ ENS BASS\ (MULTI\ SPLIT)],
  ]
%>
<svg class="casiotone" viewBox="-6 -6 1052 336" width="1052" height="336" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Casiotone MT-140">
  <defs>
    <linearGradient id="ct-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2b2b2b"/>
      <stop offset="1" stop-color="#151515"/>
    </linearGradient>
    <linearGradient id="ct-panel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a3a3a"/>
      <stop offset="1" stop-color="#262626"/>
    </linearGradient>
    <linearGradient id="ct-white" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f4f1e8"/>
      <stop offset="1" stop-color="#d9d5c8"/>
    </linearGradient>
    <linearGradient id="ct-black" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a2a2a"/>
      <stop offset="1" stop-color="#050505"/>
    </linearGradient>
  </defs>

  <%# ---- comic sound squiggles from the speaker (cloned by page.js on bass notes) ---- %>
  <g id="ct-squiggles" fill="none" stroke="#f4f1e8" stroke-width="2.2" stroke-linecap="round">
    <g class="squiggle-set" id="ct-squiggle-template" opacity="0">
      <path d="M-14 40 q-6 8 0 16 t0 16 t0 16 t0 16 t0 16"/>
      <path d="M-30 30 q-7 9 0 18 t0 18 t0 18 t0 18 t0 18" stroke-width="1.8"/>
      <path d="M-46 22 q-8 10 0 20 t0 20 t0 20 t0 20 t0 20" stroke-width="1.4"/>
    </g>
  </g>

  <%# ---- body ---- %>
  <g id="ct-body">
    <rect x="0" y="0" width="1040" height="320" rx="9" fill="url(#ct-body)"/>
    <rect x="0" y="0" width="1040" height="3" fill="#3d3d3d" opacity=".7"/>
    <rect x="0" y="312" width="1040" height="8" rx="2" fill="#101010"/>
  </g>

  <%# ---- speaker grille ---- %>
  <g id="ct-speaker">
    <rect x="8" y="12" width="202" height="140" rx="5" fill="#1c1c1c"/>
    <% (0...27).each do |i| %>
      <rect x="14" y="<%= 18 + i * 5 %>" width="190" height="2.2" rx="1" fill="#000"/>
    <% end %>
  </g>

  <%# ---- control panel: logo + sliders ---- %>
  <g id="ct-controls" font-family="Helvetica, Arial, sans-serif" fill="#ddd">
    <rect x="218" y="40" width="158" height="112" rx="2" fill="url(#ct-panel)"/>
    <g id="ct-logo" font-size="17" font-weight="900" fill="#f4f4f4">
      <% [['C', 267], ['A', 280.3], ['S', 293.6], ['I', 306.1], ['O', 311.8]].each do |(ch, x)| %>
      <text class="letter" x="<%= x %>" y="60"><%= ch %></text>
      <% end %>
    </g>

    <% sliders = [
      { id: 'power',  x: 237, label: %w[POWER],          marks: [['OFF', 118], ['ON', 92]], pos: 118 },
      { id: 'main',   x: 275, label: %w[MAIN VOLUME],    marks: [['MIN', 118], ['MAX', 74]], pos: 84 },
      { id: 'accomp', x: 313, label: %w[ACCOMP VOLUME],  marks: [['MIN', 118], ['MAX', 74]], pos: 90 },
      { id: 'chord',  x: 345, label: %w[CHORD],          marks: [['OFF', 78], ['FINGERED 1', 90], ['FINGERED 2', 100], ['CASIO CHORD', 112]], pos: 78, side: true },
    ] %>
    <% sliders.each do |s| %>
      <g id="ct-slider-<%= s[:id] %>" class="slider">
        <rect x="<%= s[:x] - 1.5 %>" y="72" width="3" height="50" rx="1.5" fill="#000"/>
        <% s[:marks].each do |(t, y)| %>
          <% if s[:side] %>
            <line x1="<%= s[:x] + 4 %>" y1="<%= y %>" x2="<%= s[:x] + 8 %>" y2="<%= y %>" stroke="#bbb" stroke-width=".8"/>
            <text x="<%= s[:x] + 10 %>" y="<%= y + 1.6 %>" font-size="3.6"><%= t %></text>
          <% else %>
            <text x="<%= s[:x] + 5 %>" y="<%= y + 1.4 %>" font-size="3.6"><%= t %></text>
          <% end %>
        <% end %>
        <g class="knob-group">
          <rect class="knob" x="<%= s[:x] - 6 %>" y="<%= s[:pos] - 7 %>" width="12" height="14" rx="1.5" fill="#3b3b3b" stroke="#000" stroke-width=".6"/>
          <rect class="knob-line" x="<%= s[:x] - 6 %>" y="<%= s[:pos] - 0.6 %>" width="12" height="1.2" fill="#ddd"/>
        </g>
        <% if s[:id] == 'power' %>
          <g class="power-hint" aria-hidden="true">
            <rect class="halo-soft" x="<%= s[:x] - 13 %>" y="66" width="26" height="60" rx="8" fill="none" stroke="#4fd1c5" stroke-width="5" opacity=".25"/>
            <rect class="halo" x="<%= s[:x] - 13 %>" y="66" width="26" height="60" rx="8" fill="none" stroke="#4fd1c5" stroke-width="1.5"/>
            <rect class="ghost" x="<%= s[:x] - 6 %>" y="<%= 118 - 7 %>" width="12" height="14" rx="1.5" fill="none" stroke="#4fd1c5" stroke-width="1.2" stroke-dasharray="2 2"/>
          </g>
          <rect class="hit" x="<%= s[:x] - 16 %>" y="62" width="32" height="70" fill="transparent"/>
        <% end %>
        <% s[:label].each_with_index do |l, i| %>
          <text x="<%= s[:x] %>" y="<%= 134 + i * 5.5 %>" text-anchor="middle" font-size="4.2" fill="<%= s[:id] == 'chord' ? '#4fd1c5' : '#e8e8e8' %>"><%= l %></text>
        <% end %>
      </g>
    <% end %>
  </g>

  <%# ---- rhythm section ---- %>
  <g id="ct-rhythm" font-family="Helvetica, Arial, sans-serif" fill="#e8e8e8">
    <% [['INTRO / ENDING', 74, 'intro'], ['START / STOP', 94, 'startstop'], ['SYNCHRO / FILL-IN', 114, 'fill']].each do |(t, y, id)| %>
      <g id="ct-btn-<%= id %>" class="button">
        <rect x="401" y="<%= y %>" width="62" height="10" rx="1.5" fill="#8f8f8f" stroke="#000" stroke-width=".6"/>
      </g>
      <text x="404" y="<%= y + 16 %>" font-size="3.6"><%= t %></text>
    <% end %>

    <text x="508" y="62" text-anchor="middle" font-size="4.6" fill="#4fd1c5" letter-spacing=".5">RHYTHM</text>
    <path d="M463 99 h14" fill="none" stroke="#bbb" stroke-width=".8"/>
    <circle id="ct-led-beat" class="led" cx="481" cy="99" r="2.4" fill="#5a1410" stroke="#000" stroke-width=".5"/>
    <circle class="led-glow" cx="481" cy="99" r="5" fill="#ff5040"/>
    <text x="493" y="101" text-anchor="middle" font-size="5" fill="#4fd1c5">▽</text>
    <text x="523" y="101" text-anchor="middle" font-size="5" fill="#4fd1c5">△</text>
    <g id="ct-btn-tempo-down" class="button"><rect x="485" y="114" width="16" height="9" rx="1" fill="#2a8fbf" stroke="#000" stroke-width=".6"/></g>
    <g id="ct-btn-tempo-up"   class="button"><rect x="515" y="114" width="16" height="9" rx="1" fill="#2a8fbf" stroke="#000" stroke-width=".6"/></g>
    <text x="508" y="133" text-anchor="middle" font-size="4.2">TEMPO</text>

    <% cols = [553, 583, 608, 633, 658] %>
    <% rhythms.each_with_index do |row, r| %>
      <% row.each_with_index do |name, c| %>
        <% next if name.empty? && r.odd? %>
        <% w = name.split(' '); lines = name.length > 7 ? w.each_slice((w.size / 2.0).ceil).map { |a| a.join(' ') } : [name] %>
        <% lines.each_with_index do |l, i| %>
          <text x="<%= cols[c] %>" y="<%= 80 + r * 18 + i * 3.8 %>" text-anchor="middle" font-size="3.1" fill="<%= r.odd? ? '#4fd1c5' : '#e8e8e8' %>"><%= l %></text>
        <% end %>
        <% if r.even? %>
        <g id="ct-btn-rhythm-<%= (r / 2) * 5 + c %>" class="button small">
          <rect x="<%= cols[c] - 6 %>" y="<%= 80 + r * 18 + 7 %>" width="12" height="4.5" rx="1" fill="#0b0b0b" stroke="#454545" stroke-width=".6"/>
        </g>
        <% end %>
      <% end %>
    <% end %>
    <g id="ct-btn-rhythm-select" class="button"><rect x="683" y="100" width="16" height="9" rx="1" fill="#22b3a0" stroke="#000" stroke-width=".6"/></g>
    <text x="691" y="118" text-anchor="middle" font-size="3.8">SELECT</text>
  </g>

  <%# ---- tone section ---- %>
  <g id="ct-tone" font-family="Helvetica, Arial, sans-serif" fill="#e8e8e8">
    <text x="743" y="62" text-anchor="middle" font-size="4.6" fill="#4fd1c5" letter-spacing=".5">TONE</text>
    <text x="900" y="58" text-anchor="middle" font-size="6.5" fill="#f0f0f0"><tspan fill="#4fd1c5">P</tspan>ulse <tspan fill="#4fd1c5">C</tspan>ode <tspan fill="#4fd1c5">M</tspan>odulation</text>

    <% cols = [743, 773, 798, 823, 850] %>
    <% tones.each_with_index do |row, r| %>
      <% row.each_with_index do |name, c| %>
        <% w = name.split(/[ -]/); lines = name.length > 7 ? w.each_slice((w.size / 2.0).ceil).map { |a| a.join(' ') } : [name] %>
        <% lines.each_with_index do |l, i| %>
          <text x="<%= cols[c] %>" y="<%= 80 + r * 18 + i * 3.8 %>" text-anchor="middle" font-size="3.1" fill="<%= r.odd? ? '#4fd1c5' : '#e8e8e8' %>"><%= l %></text>
        <% end %>
        <% if r.even? %>
        <g id="ct-btn-tone-<%= (r / 2) * 5 + c %>" class="button small">
          <rect x="<%= cols[c] - 6 %>" y="<%= 80 + r * 18 + 7 %>" width="12" height="4.5" rx="1" fill="#0b0b0b" stroke="#454545" stroke-width=".6"/>
        </g>
        <% end %>
      <% end %>
    <% end %>
    <g id="ct-btn-tone-select" class="button"><rect x="869" y="100" width="16" height="9" rx="1" fill="#22b3a0" stroke="#000" stroke-width=".6"/></g>
    <text x="877" y="118" text-anchor="middle" font-size="3.8">SELECT</text>

    <text x="928" y="98" text-anchor="middle" font-size="3.8">210 SOUND</text>
    <text x="928" y="103" text-anchor="middle" font-size="3.8">TONE BANK</text>
    <g id="ct-btn-tonebank" class="button"><rect x="919" y="118" width="18" height="9" rx="1" fill="#e0602a" stroke="#000" stroke-width=".6"/></g>

    <text x="1000" y="104" text-anchor="middle" font-size="4.4" letter-spacing=".4">DEMO</text>
    <rect x="982" y="109" width="36" height="24" rx="2" fill="#5a5a5a"/>
    <g id="ct-btn-demo" class="button"><rect x="989" y="116" width="22" height="10" rx="1.5" fill="#d8322b" stroke="#000" stroke-width=".6"/></g>

    <text x="1018" y="166" text-anchor="end" font-size="8.5" fill="#f4f4f4" font-style="italic" font-weight="600">Casiotone MT-140</text>
  </g>

  <%# ---- note labels over the chord section (evenly spaced, as on the real panel) ---- %>
  <g id="ct-note-labels" font-family="Helvetica, Arial, sans-serif" font-size="4.6" fill="#e8e8e8" text-anchor="middle">
    <% 18.times do |i| %>
      <text x="<%= 54 + i * 19.6 %>" y="169"><%= names[i % 12] %></text>
    <% end %>
    <text x="<%= 54 + 18 * 19.6 + 6 %>" y="169" font-size="4.2">◂ CHORD</text>
  </g>

  <%# ---- keyboard: 29 white + 20 black = 49 mini keys ---- %>
  <g id="ct-keys">
    <% 29.times do |i| %>
      <% midi = 48 + (i / 7) * 12 + [0, 2, 4, 5, 7, 9, 11][i % 7] %>
      <% x = key_x0 + i * white_w + 0.6; w = white_w - 1.2 %>
      <g class="key white" data-midi="<%= midi %>">
        <rect class="face" x="<%= x %>" y="<%= key_y %>" width="<%= w %>" height="<%= white_h %>" rx="1.5" fill="url(#ct-white)" stroke="#8a867a" stroke-width=".6"/>
        <%# front lip: the key face ends and drops away %>
        <rect x="<%= x %>" y="<%= key_y + white_h - 5 %>" width="<%= w %>" height="5" rx="1.5" fill="#000" opacity=".16"/>
        <rect x="<%= x %>" y="<%= key_y + white_h - 5 %>" width="<%= w %>" height="1" fill="#000" opacity=".22"/>
        <%# shadow cast by the neighbour on the left, highlight on the right edge %>
        <rect x="<%= x %>" y="<%= key_y %>" width="1.6" height="<%= white_h - 5 %>" fill="#000" opacity=".1"/>
        <rect x="<%= x + w - 1 %>" y="<%= key_y %>" width="1" height="<%= white_h - 5 %>" fill="#fff" opacity=".35"/>
      </g>
    <% end %>
    <%# opaque backing so the white-key divider never shows through a lit black key %>
    <% 28.times do |i| %>
      <% next unless black_after.include?(i % 7) %>
      <rect class="key-backing" x="<%= key_x0 + (i + 1) * white_w - black_w / 2 %>" y="<%= key_y %>" width="<%= black_w %>" height="<%= black_h %>" rx="1.5" fill="#111"/>
    <% end %>
    <% 28.times do |i| %>
      <% next unless black_after.include?(i % 7) %>
      <% midi = 48 + (i / 7) * 12 + [0, 2, 4, 5, 7, 9, 11][i % 7] + 1 %>
      <% x = key_x0 + (i + 1) * white_w - black_w / 2 %>
      <g class="key black" data-midi="<%= midi %>">
        <rect class="face" x="<%= x %>" y="<%= key_y %>" width="<%= black_w %>" height="<%= black_h %>" rx="1.5" fill="url(#ct-black)" stroke="#000" stroke-width=".6"/>
        <%# raised top face, narrower than the body %>
        <rect x="<%= x + 3 %>" y="<%= key_y + 1.5 %>" width="<%= black_w - 6 %>" height="<%= black_h - 9 %>" rx="1" fill="#fff" opacity=".07"/>
        <rect x="<%= x + 3 %>" y="<%= key_y + 1.5 %>" width="<%= black_w - 6 %>" height="1.2" fill="#fff" opacity=".18"/>
        <%# front slope %>
        <rect x="<%= x %>" y="<%= key_y + black_h - 5 %>" width="<%= black_w %>" height="5" rx="1.5" fill="#000" opacity=".45"/>
        <rect x="<%= x + 1 %>" y="<%= key_y + black_h - 5 %>" width="<%= black_w - 2 %>" height="1" fill="#fff" opacity=".12"/>
      </g>
    <% end %>
  </g>
  <%# ---- "turn on" callout, shown while the instrument is off ---- %>
  <g id="ct-callout" class="callout">
    <path d="M252 -52 c-22 12 -32 46 -20 92 q3 12 5 60" fill="none" stroke="#f4f1e8" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 5"/>
    <path d="M232 92 l5 10 l7 -8" fill="none" stroke="#f4f1e8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <text class="callout-text" x="266" y="-58" fill="#f4f1e8" transform="rotate(-6 266 -58)">turn it on</text>
    <text class="callout-text callout-retry" x="266" y="-58" fill="#f4f1e8" transform="rotate(-6 266 -58)">try again, the power cable is finicky</text>
  </g>
</svg>
